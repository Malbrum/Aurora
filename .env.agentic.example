# Kopier til .env.agentic (ignorert av git). Bare lesing mot Gmail og BRP.
# Bjørns personlige nøkkel til utprøving. Tom = SDK-ens eget oppslag (ANTHROPIC_API_KEY i miljøet eller `ant auth login`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Valgfritt: lås inferens til en geografi, f.eks. eu
ANTHROPIC_INFERENCE_GEO=
MAX_TURNS=12

BRP_API_BASE_URL=https://roabadet.brpsystems.com/apiserver
BRP_API_USERNAME=
BRP_API_PASSWORD=

GMAIL_ACCOUNT=medlemsservice@roabadet.no
GMAIL_CHANNEL_ADDRESS=post@roabadet.no
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_DAYS=14

AGENTIC_DB=data/agentic.db
